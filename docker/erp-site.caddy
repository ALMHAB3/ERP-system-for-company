# The application itself (shared by every way of reaching it: LAN, public domain, tunnel).
root * /var/www/html/public
encode zstd gzip
header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy no-referrer
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}
@app path /app/*
header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
@hidden path /.* /storage/* /vendor/*
respond @hidden 404
# The real client address for rate limiting and the audit log (never trust a header sent by the browser itself)
request_header X-Forwarded-For {client_ip}
# /app/ is a static folder (the web interface): serve its index page instead of handing the request to Laravel
@appdir path /app /app/
rewrite @appdir /app/index.html
php_fastcgi app:9000
file_server
