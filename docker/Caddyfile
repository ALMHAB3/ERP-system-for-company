# DEFAULT: office network only, HTTPS from Caddy's own local CA (install its root certificate once on each device).
# For the internet see docs/INTERNET-ACCESS.md (public domain: docker/Caddyfile.public; no open ports: Cloudflare tunnel).
{
	auto_https disable_redirects
	# The tunnel's plain-HTTP origin (below) is the ONLY listener that believes a client-IP header, and only from private addresses.
	servers :8081 {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$ERP_HOST:erp.local} {
	tls internal
	import /etc/caddy/erp-site.caddy
}

# Origin for the optional Cloudflare tunnel. Reachable only from inside the docker network (port is not published).
:8081 {
	import /etc/caddy/erp-site.caddy
}
